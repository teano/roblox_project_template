{
  "name": "roblox_project_template",
  "servePort": 34873,
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$path": "src/ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Shared": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Client": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },

    "ReplicatedFirst": {
      "$path": "src/ReplicatedFirst",
      "$ignoreUnknownInstances": true
    },

    "ServerScriptService": {
      "$path": "src/ServerScriptService",
      "$ignoreUnknownInstances": true
    },

    "ServerStorage": {
      "$ignoreUnknownInstances": true,
      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayerScripts",
        "$ignoreUnknownInstances": true
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [
            0.38823,
            0.37254,
            0.38823
          ],
          "Locked": true,
          "Position": [
            0,
            -10,
            0
          ],
          "Size": [
            512,
            20,
            512
          ]
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
