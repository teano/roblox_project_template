{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/roblox-template/feature-manifest.schema.json",
  "title": "Repository feature manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "title",
    "status",
    "activity",
    "branch",
    "baseCommit",
    "startedAt",
    "completedAt",
    "updatedAt",
    "blockers",
    "artifacts",
    "verification",
    "recoveryLog"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^(TF|F)-[0-9]{4}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["planned", "in_progress", "ready"] },
    "activity": { "enum": ["none", "active", "paused"] },
    "branch": { "type": ["string", "null"] },
    "baseCommit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "verification": {
      "type": ["object", "null"],
      "required": ["completedAt", "head", "summary"],
      "properties": {
        "completedAt": { "type": "string", "format": "date-time" },
        "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "summary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "recoveryLog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "reason", "previousStatus"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "reason": { "type": "string", "minLength": 1 },
          "previousStatus": { "enum": ["ready"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
